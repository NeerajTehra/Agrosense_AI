<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Field"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/farm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Select Farm"
            android:textColor="@color/leaf_green"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"/>

        <Spinner
            android:id="@+id/spinnerFarm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/spinner_background"
            android:paddingHorizontal="12dp"
            app:layout_constraintTop_toBottomOf="@id/farm_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFieldName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxStrokeColor="@color/leaf_green"
            app:hintTextColor="@color/leaf_green"
            app:layout_constraintTop_toBottomOf="@id/spinnerFarm">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFieldName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Field Name"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCropType"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxStrokeColor="@color/leaf_green"
            app:hintTextColor="@color/leaf_green"
            app:layout_constraintTop_toBottomOf="@id/tilFieldName">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCropType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Crop Type (e.g. Tomato)"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilArea"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxStrokeColor="@color/leaf_green"
            app:hintTextColor="@color/leaf_green"
            app:layout_constraintTop_toBottomOf="@id/tilCropType">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Field Area (Acres)"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveField"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:text="Save Field"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/leaf_green"
            app:layout_constraintTop_toBottomOf="@id/tilArea" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
