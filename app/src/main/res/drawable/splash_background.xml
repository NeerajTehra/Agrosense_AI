<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:endColor="@color/leaf_green_dark"
                android:startColor="@color/leaf_green"
                android:type="linear" />
        </shape>
    </item>
    <!-- Subtle decorative circles -->
    <item
        android:top="-100dp"
        android:right="-100dp">
        <shape android:shape="oval">
            <solid android:color="#0DFFFFFF" />
            <size android:width="300dp" android:height="300dp" />
        </shape>
    </item>
    <item
        android:bottom="-50dp"
        android:left="-50dp">
        <shape android:shape="oval">
            <solid android:color="#08FFFFFF" />
            <size android:width="200dp" android:height="200dp" />
        </shape>
    </item>
</layer-list>
