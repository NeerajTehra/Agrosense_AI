<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Agrosense_AI" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/leaf_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/leaf_green_light</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/earth_brown</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background and Surface -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/input_border</item>
        <item name="colorError">@color/error_red</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:editTextColor">@color/text_primary</item>

        <!-- Material Component Colors -->
        <item name="colorControlNormal">@color/text_hint</item>
        <item name="colorControlActivated">@color/leaf_green</item>
        <item name="colorControlHighlight">@color/leaf_green_light</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/leaf_green_dark</item>
    </style>

    <style name="Theme.Agrosense_AI" parent="Base.Theme.Agrosense_AI" />
</resources>
